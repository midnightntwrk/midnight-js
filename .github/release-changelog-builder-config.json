{
  "categories": [
    {
      "title": "### Features",
      "labels": [],
      "rules": [{ "pattern": "^feat(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Bug Fixes",
      "labels": [],
      "rules": [{ "pattern": "^fix(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Documentation",
      "labels": [],
      "rules": [{ "pattern": "^docs(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Refactoring",
      "labels": [],
      "rules": [{ "pattern": "^refactor(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Tests",
      "labels": [],
      "rules": [{ "pattern": "^test(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Performance",
      "labels": [],
      "rules": [{ "pattern": "^perf(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    },
    {
      "title": "### Maintenance",
      "labels": [],
      "rules": [{ "pattern": "^(chore|build|ci|style|revert)(\\(.+\\))?!?:", "on_property": "title", "flags": "i" }]
    }
  ],
  "ignore_labels": [],
  "sort": { "order": "ASC", "on_property": "mergedAt" },
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
  "empty_template": "_No notable changes._"
}
