{
  "$schema": "https://turbo.build/schema.v2.json",
  "envMode": "loose",
  "agentGuidance": false,
  "globalEnv": ["COMPACTC_VERSION"],
  "globalDependencies": ["build-tools/**", "tsconfig.base.json", "scripts/check-compiled.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/test/**",
        "rollup.config.mjs",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "clean-build": {
      "cache": false,
      "dependsOn": [
        "clean",
        "build"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "it": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "e2e-single": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "check": {
      "cache": false,
      "dependsOn": ["build", "test"]
    },
    "compact": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
