{
  "name": "@midnightntwrk/midnight-js-monorepo",
  "description": "Midnight application development framework",
  "version": "5.0.3",
  "packageManager": "yarn@4.14.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-js#readme",
  "bugs": {
    "url": "https://github.com/midnightntwrk/midnight-js/issues"
  },
  "author": "Midnight Foundation",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "testkit-js/*"
  ],
  "scripts": {
    "clean": "turbo run clean",
    "build": "turbo run build",
    "build:core": "turbo run build --filter='!@midnightntwrk/testkit-*'",
    "build:testkit": "turbo run build --filter='@midnightntwrk/testkit-*'",
    "clean-build": "turbo run clean-build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='!@midnightntwrk/testkit-*'",
    "it": "turbo run it",
    "test:workflow-scripts": "vitest run --config .github/scripts/vitest.config.mjs",
    "test:consumer-e2e": "vitest run --config consumer-e2e/vitest.config.mjs",
    "e2e": "turbo run e2e",
    "e2e-single": "turbo run e2e-single",
    "check": "turbo run check && yarn lint && yarn constraints",
    "typecheck:tests": "yarn typecheck:tests:core && yarn typecheck:tests:testkit",
    "typecheck:tests:core": "bash -c 'for cfg in packages/*/tsconfig.json; do tsc --noEmit --composite false -p \"$cfg\" || exit 1; done'",
    "typecheck:tests:testkit": "bash -c 'for cfg in testkit-js/*/tsconfig.json; do tsc --noEmit --composite false -p \"$cfg\" || exit 1; done'",
    "typecheck:consumer-e2e": "tsc -p consumer-e2e/tsconfig.json",
    "check:core": "turbo run check --filter='!@midnightntwrk/testkit-*' && yarn lint",
    "build:markdown-docs": "typedoc --validation --plugin typedoc-plugin-markdown --options typedoc.json",
    "lint": "eslint",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=16192 eslint ./packages --fix",
    "changelog": "commit-and-tag-version --skip.bump --skip.commit --skip.tag",
    "changelog:first": "rm -f CHANGELOG.md && commit-and-tag-version --skip.bump --skip.commit --skip.tag --release-as $(node -p \"require('./package.json').version\")",
    "postinstall": "husky",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@d2t/vitest-ctrf-json-reporter": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@yarnpkg/types": "^4.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-xml-parser": "^5.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pinst": "^3.0.0",
    "pnpm": "12.22.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "semver": "^7.8.6",
    "turbo": "^2.11.11",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.ts": "eslint --cache"
  },
  "resolutions": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.2",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnight-ntwrk/ledger-v8": "npm:@midnightntwrk/ledger-v8@8.1.3",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "effect": "3.22.1",
    "undici": ">=7.24.0",
    "tar": ">=7.5.22",
    "fast-xml-parser": ">=5.7.0",
    "eslint-plugin-import/minimatch": ">=3.1.4 <4.0.0",
    "minimatch": ">=9.0.5",
    "rollup": ">=4.68.2 <5.0.0",
    "immutable": ">=3.8.3",
    "diff": ">=4.0.4",
    "fast-uri": ">=4.2.3",
    "yaml": ">=2.8.3",
    "ip-address": ">=10.7.6",
    "protobufjs": ">=7.6.4 <8.0.0",
    "@protobufjs/utf8": ">=1.1.1",
    "lodash": ">=4.18.1",
    "ws": ">=8.20.1",
    "qs": ">=6.17.1",
    "tmp": ">=0.2.7",
    "uuid": ">=11.1.1 <12.0.0"
  }
}
