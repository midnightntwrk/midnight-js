# Supply-chain cooldown: refuse versions published <7 days ago, so a freshly
# published (potentially wormed) release cannot resolve here (npm 12+).
#
# Scope is narrower than it looks. Project dependencies are installed by Yarn 4,
# which does not read .npmrc at all -- those are pinned by yarn.lock. This file
# reaches only the handful of `npx` / `npm install -g` calls in CI that fetch
# report and lint tooling straight from the registry, which is exactly where no
# lockfile applies.
min-release-age=7
