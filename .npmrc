# Supply-chain cooldown: refuse versions published <7 days ago, so a freshly
# published (possibly compromised) release cannot resolve here (npm >= 11.10).
#
# This file reaches only npm and npx run from the checkout. Yarn 4 does not
# read it (project dependencies are pinned by yarn.lock), and `npm install -g`
# ignores it, so CI sets the same cooldown in the environment through
# .github/actions/setup-npm.
min-release-age=7
