{
  "name": "@midnight-ntwrk/midnight-js-protocol",
  "version": "5.0.0-beta.7",
  "type": "module",
  "description": "Protocol type re-exports for midnight-js framework",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "default": "./dist/ledger.js"
    },
    "./compact-runtime": {
      "types": "./dist/compact-runtime.d.ts",
      "default": "./dist/compact-runtime.js"
    },
    "./compact-js": {
      "types": "./dist/compact-js.d.ts",
      "default": "./dist/compact-js.js"
    },
    "./compact-js/effect": {
      "types": "./dist/compact-js-effect.d.ts",
      "default": "./dist/compact-js-effect.js"
    },
    "./compact-js/effect/Contract": {
      "types": "./dist/compact-js-effect-contract.d.ts",
      "default": "./dist/compact-js-effect-contract.js"
    },
    "./onchain-runtime": {
      "types": "./dist/onchain-runtime.d.ts",
      "default": "./dist/onchain-runtime.js"
    },
    "./platform-js": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./platform-js/effect/Configuration": {
      "types": "./dist/platform-effect-configuration.d.ts",
      "default": "./dist/platform-effect-configuration.js"
    },
    "./platform-js/effect/ContractAddress": {
      "types": "./dist/platform-effect-contract-address.d.ts",
      "default": "./dist/platform-effect-contract-address.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": "git@github.com:midnight-ntwrk/artifacts",
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "deploy": "yarn npm publish --tolerate-republish"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.5-rc.8",
    "@midnight-ntwrk/compact-runtime": "0.19.0-rc.0",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
