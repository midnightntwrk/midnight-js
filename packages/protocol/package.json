{
  "name": "@midnightntwrk/midnight-js-protocol",
  "version": "5.0.2",
  "type": "module",
  "description": "Protocol type re-exports for midnight-js framework",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./prove": {
      "types": "./dist/prove.d.ts",
      "default": "./dist/prove.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "default": "./dist/transaction.js"
    },
    "./v8": {
      "types": "./dist/v8.d.ts",
      "default": "./dist/v8.js"
    },
    "./v9": {
      "types": "./dist/v9.d.ts",
      "default": "./dist/v9.js"
    },
    "./v9/compact-runtime": {
      "types": "./dist/v9-compact-runtime.d.ts",
      "default": "./dist/v9-compact-runtime.js"
    },
    "./v9/compact-js": {
      "types": "./dist/v9-compact-js.d.ts",
      "default": "./dist/v9-compact-js.js"
    },
    "./v9/compact-js/effect": {
      "types": "./dist/v9-compact-js-effect.d.ts",
      "default": "./dist/v9-compact-js-effect.js"
    },
    "./v9/compact-js/effect/Contract": {
      "types": "./dist/v9-compact-js-effect-contract.d.ts",
      "default": "./dist/v9-compact-js-effect-contract.js"
    },
    "./v9/onchain-runtime": {
      "types": "./dist/v9-onchain-runtime.d.ts",
      "default": "./dist/v9-onchain-runtime.js"
    },
    "./v8/engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./compact-js/v8/effect": {
      "types": "./dist/compact-js-v8-effect.d.ts",
      "default": "./dist/compact-js-v8-effect.js"
    },
    "./platform-js": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./platform-js/effect/Configuration": {
      "types": "./dist/platform-effect-configuration.d.ts",
      "default": "./dist/platform-effect-configuration.js"
    },
    "./platform-js/effect/ContractAddress": {
      "types": "./dist/platform-effect-contract-address.d.ts",
      "default": "./dist/platform-effect-contract-address.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-js/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/midnightntwrk/midnight-js/issues"
  },
  "author": "Midnight Foundation",
  "packageManager": "yarn@4.14.1",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/onchain-runtime-v3": "^3.0.0",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v8": "8.1.3",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "compact-runtime-ledger8": "npm:@midnight-ntwrk/compact-runtime@0.16.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/ledger-v8": "npm:@midnightntwrk/ledger-v8@8.1.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
