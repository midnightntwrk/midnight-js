import CompactStandardLibrary;

contract Callee {
    circuit deposit(coin: ShieldedCoinInfo): [];
    circuit mintAndSend(domainSep: Bytes<32>, mintValue: Uint<64>, mintNonce: Bytes<32>, publicKey: ZswapCoinPublicKey, sendValue: Uint<128>): ShieldedSendResult;
}

export ledger callee: Callee;

constructor(target: Callee) {
    callee = disclose(target);
}

export circuit depositToCallee(coin: ShieldedCoinInfo): [] {
    callee.deposit(disclose(coin));
}

export circuit mintAndSendFromCallee(domainSep: Bytes<32>, mintValue: Uint<64>, mintNonce: Bytes<32>, publicKey: ZswapCoinPublicKey, sendValue: Uint<128>): ShieldedSendResult {
    return callee.mintAndSend(disclose(domainSep), disclose(mintValue), disclose(mintNonce), disclose(publicKey), disclose(sendValue));
}
