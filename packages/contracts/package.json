{
  "name": "@midnightntwrk/midnight-js-contracts",
  "version": "5.0.0-rc.3",
  "type": "module",
  "description": "MidnightJS module for interacting with contracts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/contracts"
  },
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "compact": "yarn fetch-compactc && yarn compact-shielded",
    "compact-shielded": "run-compactc src/test/resources/shielded-map.compact ./src/test/resources/compiled/shielded-map",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "test-no-utils": "vitest run --exclude src/test/*.test.ts"
  },
  "dependencies": {
    "@midnightntwrk/midnight-js-network-id": "workspace:*",
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-types": "workspace:*",
    "@midnightntwrk/midnight-js-utils": "workspace:*",
    "effect": "^3.22.1"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@midnightntwrk/midnight-js-compact": "workspace:*",
    "rollup": "^4.60.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
