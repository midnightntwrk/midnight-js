{
  "name": "@midnightntwrk/midnight-js-indexer-public-data-provider",
  "version": "5.0.2",
  "type": "module",
  "description": "Implementation of public data provider based on the Midnight Pub-sub indexer",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/indexer-public-data-provider"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-js/tree/main/packages/indexer-public-data-provider#readme",
  "bugs": {
    "url": "https://github.com/midnightntwrk/midnight-js/issues"
  },
  "author": "Midnight Foundation",
  "packageManager": "yarn@4.14.1",
  "license": "Apache-2.0",
  "scripts": {
    "gen": "rm -rf gen && graphql-codegen",
