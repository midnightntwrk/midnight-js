    "graphql-ws": "^6.4.2",
    "isomorphic-ws": "^5.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/ws": "^8.18.2",
    "rollup": "^4.68.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist/"
  ],
