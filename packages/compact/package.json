{
  "name": "@midnightntwrk/midnight-js-compact",
  "description": "Compact fetcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/compact"
  },
  "author": "IOG",
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0",
  "version": "5.0.0-rc.3",
  "type": "module",
  "bin": {
    "fetch-compactc": "dist/fetch-compact.mjs",
    "run-compactc": "dist/run-compactc.cjs"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo managed dist",
    "build": "tsc -p tsconfig.build.json && cp src/run-compactc.cjs dist/",
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnightntwrk/midnight-js-utils": "workspace:*"
  },
  "packageManager": "yarn@4.14.1"
}
