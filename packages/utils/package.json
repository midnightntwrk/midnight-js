{
  "name": "@midnightntwrk/midnight-js-utils",
  "version": "5.0.2",
  "type": "module",
  "description": "Shared utilities for MidnightJS modules",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/utils"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-js/tree/main/packages/utils#readme",
  "bugs": {
    "url": "https://github.com/midnightntwrk/midnight-js/issues"
  },
  "author": "Midnight Foundation",
  "packageManager": "yarn@4.14.1",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-types": "workspace:*",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.1",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rollup": "^4.68.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
