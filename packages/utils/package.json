{
  "name": "@midnightntwrk/midnight-js-utils",
  "version": "5.0.0-rc.3",
  "type": "module",
  "description": "Shared utilities for MidnightJS modules",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/utils"
  },
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnightntwrk/midnight-js-network-id": "workspace:*",
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-types": "workspace:*",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-rc.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rollup": "^4.60.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
