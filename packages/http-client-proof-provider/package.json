{
  "name": "@midnightntwrk/midnight-js-http-client-proof-provider",
  "version": "5.0.0-rc.3",
  "type": "module",
  "description": "Implementation of proof provider based on the Midnight ledger proof server",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": "git@github.com:midnight-ntwrk/artifacts",
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage logs src/test/resources/compiled",
    "compact": "yarn fetch-compactc && yarn compact-simple",
    "compact-simple": "run-compactc src/test/resources/simple.compact ./src/test/resources/compiled/simple",
    "build": "node ../../scripts/check-compiled.js src/test/resources/compiled && rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnightntwrk/midnight-js-network-id": "workspace:*",
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-types": "workspace:*",
    "@midnightntwrk/midnight-js-utils": "workspace:*",
    "cross-fetch": "^4.1.0",
    "fetch-retry": "^6.0.0"
  },
  "devDependencies": {
    "@midnightntwrk/midnight-js-compact": "workspace:*",
    "@midnightntwrk/midnight-js-contracts": "workspace:*",
    "rollup": "^4.60.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
