{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "compact": "COMPACTC_VERSION=0.29.0 yarn fetch-compactc && yarn contract-demo",
