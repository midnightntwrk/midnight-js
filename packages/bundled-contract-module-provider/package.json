{
  "name": "@midnightntwrk/midnight-js-bundled-contract-module-provider",
  "version": "5.0.0-rc.3",
  "type": "module",
  "description": "MidnightJS module resolving cross-contract callees to the compiled contract modules bundled with an application",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "author": "IOG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/bundled-contract-module-provider"
  },
  "packageManager": "yarn@4.14.1",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-utils": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
