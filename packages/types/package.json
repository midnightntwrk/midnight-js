{
  "name": "@midnightntwrk/midnight-js-types",
  "version": "5.0.0-rc.3",
  "type": "module",
  "description": "Shared data types and interfaces for MidnightJS modules",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/types"
  },
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "effect": "^3.22.1",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "rollup": "^4.60.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
