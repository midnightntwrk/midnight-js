{
  "name": "@midnightntwrk/midnight-js",
  "version": "5.0.1",
  "type": "module",
  "description": "Barrel package for Midnight.js core framework",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./protocol/v9": {
      "types": "./dist/protocol/v9.d.ts",
      "default": "./dist/protocol/v9.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-js.git",
    "directory": "packages/midnight-js"
  },
  "homepage": "https://github.com/midnightntwrk/midnight-js/tree/main/packages/midnight-js#readme",
  "bugs": {
    "url": "https://github.com/midnightntwrk/midnight-js/issues"
  },
  "author": "Midnight Foundation",
  "packageManager": "yarn@4.14.1",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnightntwrk/midnight-js-contracts": "workspace:*",
    "@midnightntwrk/midnight-js-protocol": "workspace:*",
    "@midnightntwrk/midnight-js-types": "workspace:*",
    "@midnightntwrk/midnight-js-utils": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
