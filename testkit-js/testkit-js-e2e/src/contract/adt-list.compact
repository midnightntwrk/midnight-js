// List ADT test contract
import CompactStandardLibrary;

export ledger list: List<Field>;
export ledger length: Uint<64>;
export ledger is_empty: Boolean;
export ledger head_value: Maybe<Field>;
export ledger length_after_pop: Uint<64>;
export ledger new_head: Maybe<Field>;
export ledger final_empty: Boolean;
export ledger final_length: Uint<64>;
export ledger final_head: Maybe<Field>;
export ledger coin_list: List<QualifiedShieldedCoinInfo>;
export ledger coin_length: Uint<64>;
export ledger coin_head: Maybe<QualifiedShieldedCoinInfo>;

// Separate circuit to mint coins first
export circuit mint_coins_for_test(): Field {
    // Mint coins to contract to allocate Merkle tree indices
    const coin1 = mintShieldedToken(
        pad(32, "listToken"),
        100 as Uint<64>,
        pad(32, "listNonce1"),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );

    const coin2 = mintShieldedToken(
        pad(32, "listToken"),
        200 as Uint<64>,
        pad(32, "listNonce2"),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );

    // Receive the coins to claim them
    receiveShielded(coin1);
    receiveShielded(coin2);

    // Store coins in the list for later use
    coin_list.pushFrontCoin(coin1, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
    coin_list.pushFrontCoin(coin2, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));

    return 2 as Field; // Return number of coins minted
}

